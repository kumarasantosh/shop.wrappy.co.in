# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Supabase (server - service role)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_XXXXXXXX
CLERK_SECRET_KEY=sk_XXXXXXXX

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_ADMIN_USER_IDS= # comma separated Clerk user ids allowed as admin

# Uber Direct — credentials from https://direct.uber.com (Developer tab)
UBER_DIRECT_CUSTOMER_ID=         # the customer UUID from the deliveries URL
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_WEBHOOK_SECRET=      # webhook signing secret from the dashboard
UBER_DIRECT_TEST_MODE=true       # true = sandbox (simulated courier), false = live
# Optional overrides (defaults shown):
# UBER_AUTH_URL=https://auth.uber.com/oauth/v2/token
# UBER_API_BASE=https://api.uber.com
# UBER_DIRECT_SCOPE=eats.deliveries

# Uber Direct — pickup location (your store; where the courier collects orders)
UBER_PICKUP_NAME=Wrappy
UBER_PICKUP_BUSINESS_NAME=Wrappy
UBER_PICKUP_ADDRESS=             # full single-line store address
UBER_PICKUP_PHONE=              # E.164 format, e.g. +919999999999
UBER_PICKUP_LATITUDE=
UBER_PICKUP_LONGITUDE=
UBER_PICKUP_NOTES=              # optional courier instructions at pickup

