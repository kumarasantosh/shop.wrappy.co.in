# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key

# Supabase (server - service role)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_XXXXXXXX
CLERK_SECRET_KEY=sk_XXXXXXXX

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxxxxx

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CLERK_ADMIN_USER_IDS= # comma separated Clerk user ids allowed as admin

# ── WhatsApp Food-Order Flow ──────────────────────────────────────────────────
# From: developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=          # e.g. 12345678901234
WHATSAPP_ACCESS_TOKEN=             # e.g. EAAxxxxxxxxxxxxx
WEBHOOK_VERIFY_TOKEN=              # any random secret string you choose

# Restaurant / menu config
RESTAURANT_NAME=Wrappy
DELIVERY_CHARGE=30                 # flat delivery fee in rupees

# Razorpay webhook secret (for payment_link.paid signature verification)
RAZORPAY_WEBHOOK_SECRET=

# ── Last-mile delivery (Porter) ──────────────────────────────────────
# Porter — request API credentials at https://porter.in/api-integrations
PORTER_TEST_MODE=true           # true = UAT (pfe-apigw-uat.porter.in), false = prod
PORTER_API_KEY=                 # X-API-KEY from Porter
PORTER_WEBHOOK_SECRET=          # optional; only if Porter provides a signing secret
# Pickup location (your store; where the courier collects orders)
PORTER_PICKUP_NAME=Wrappy
PORTER_PICKUP_PHONE=            # store phone, 10-digit
PORTER_PICKUP_ADDRESS=         # store street address
PORTER_PICKUP_CITY=
PORTER_PICKUP_STATE=
PORTER_PICKUP_PINCODE=
PORTER_PICKUP_LATITUDE=
PORTER_PICKUP_LONGITUDE=
# Optional overrides:
# PORTER_API_BASE=              # override base URL
# PORTER_FARE_IN_PAISE=true     # treat Porter fares as paise (default true)

