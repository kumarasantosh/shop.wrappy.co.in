# ─────────────────────────────────────────────────────────────────────────────
# Wrappy Web — environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ADMIN_USER_IDS=           # comma-separated Clerk user IDs with admin access

# ── Razorpay (payments) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=        # from Razorpay dashboard → Settings → Webhooks

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://shop.wrapznfryz.com
NEXT_PUBLIC_APP_URL=https://shop.wrapznfryz.com

# ── Borzo Delivery API ────────────────────────────────────────────────────────
# Docs: https://borzodelivery.com/in/business-api/doc
#
# 1. Register / log in at https://robotapitest-in.borzodelivery.com (sandbox)
#    or https://cabinet.borzodelivery.com/in (production).
# 2. Copy your Auth Token from the "API Test" section of your cabinet.
# 3. Set your callback URL in cabinet → Integration → Callback URL:
#      https://your-domain.com/api/borzo/callback
# 4. Copy the Callback Token from the same Integration page.

BORZO_AUTH_TOKEN=               # X-DV-Auth-Token header value
BORZO_BASE_URL=https://robotapitest-in.borzodelivery.com/api/business/1.6
# ↑ Switch to https://api-in.borzodelivery.com/api/business/1.6 for production

BORZO_CALLBACK_TOKEN=           # HMAC-SHA256 signing token from Borzo Integration tab
# ↑ Leave blank in dev to skip signature verification (unsafe for production)

# ── Store / pickup location ───────────────────────────────────────────────────
# These coordinates are used as the Borzo pickup point for every delivery.
STORE_LATITUDE=17.497761893885446
STORE_LONGITUDE=78.394967441416
NEXT_PUBLIC_STORE_LATITUDE=17.497761893885446
NEXT_PUBLIC_STORE_LONGITUDE=78.394967441416

# ── Delivery fee config ───────────────────────────────────────────────────────
DELIVERY_BASE_FEE=40
DELIVERY_FEE_PER_KM=10
FREE_DELIVERY_ABOVE=500
NEXT_PUBLIC_MAX_DELIVERY_KM=10

# ── WhatsApp (Meta Business API) ──────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your@email.com
